# No pegues una URL real en este archivo ni lo subas a Git.
TEAMS_WEBHOOK_URL=https://example.invalid/replace-with-your-new-webhook

# Opcional. Docker genera uno persistente en runtime/api-token si se omite.
MONITOR_API_TOKEN=replace-with-a-long-random-token
MONITOR_API_HOST=127.0.0.1
MONITOR_API_PORT=8787
MONITOR_INTERVAL_MINUTES=15
MONITOR_RUN_ON_START=true
MONITOR_API_BIND=127.0.0.1
